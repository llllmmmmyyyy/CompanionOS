GEMINI_API_KEY=
HUAWEI_MAAS_API_KEY=
# Exact enabled chat model from your MaaS console; blank disables Huawei planning.
HUAWEI_MAAS_MODEL=
HUAWEI_MAAS_VIDEO_MODEL=Wan2.2-T2V-A14B
# Exact trusted storage host(s) returned by your MaaS deployment, comma separated.
HUAWEI_VIDEO_DOWNLOAD_HOSTS=
GEMINI_MODEL=gemini-2.5-flash
VEO_MODEL=veo-3.1-generate-preview
PORT=18080
# Emulator gateway 10.0.2.2 reaches the Windows host loopback listener directly.
HOST=127.0.0.1
# Review generated clips before exposing them to children.
REQUIRE_VIDEO_REVIEW=true
